    <!-- Component Loader -->
  <script src="js/utils/component-loader.js"></script>
  <!-- Header Manager -->
  <script src="js/components/header.js"></script>
  <!-- Footer Manager -->
  <script src="js/components/footer.js"></script>
  <!-- Mobile Menu Manager -->
  <script src="js/components/mobile-menu.js"></script>
  <script>
    // Load header and footer components on page load
    document.addEventListener('DOMContentLoaded', async () => {
      const loader = new ComponentLoader();
      
      // Load header and footer components
      await loader.loadMultiple([
        { name: 'header', target: '#header-placeholder', method: 'replace' },
        { name: 'footer', target: '#footer-placeholder', method: 'replace' },
        { name: 'mobile-menu', target: '#mobile-menu-placeholder', method: 'replace' }
      ]);

      // Initialize header functionality after component is loaded
      const headerManager = new HeaderManager();
      await headerManager.init();

      // Initialize footer functionality after component is loaded
      const footerManager = new FooterManager();
      footerManager.init();

      // Initialize mobile menu functionality after component is loaded
      const mobileMenuManager = new MobileMenuManager();
      mobileMenuManager.init();
    });
  </script>
    <!-- Header Manager -->
    <script src="js/components/header.js"></script>
    <script>
        // Load header component on page load
        document.addEventListener('DOMContentLoaded', async () => {
            const loader = new ComponentLoader();
            await loader.load('header', '#header-placeholder', 'replace');

            // Initialize header functionality after component is loaded
            const headerManager = new HeaderManager();
            await headerManager.init();
        });
    </script>

    <script src="js/common.js"></script>
    <script src="js/product_detail.js"></script>
