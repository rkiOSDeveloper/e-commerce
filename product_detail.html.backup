                    <span class="material-icons text-xl">search</span>
                </button>
            </div>
            <div>
                <p class="text-sm text-gray-500 dark:text-gray-400 mb-2">
                    Popular Searches:
                </p>
                <div class="flex flex-wrap gap-2">
                    <a href="product_list.html?search=T-Shirt"
                        class="text-sm underline text-gray-900 dark:text-white hover:text-gray-600 dark:hover:text-gray-300">T-Shirt</a>
