<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <link rel="icon" href="images/clothyfly_favicon.jpg" />

    <title>Clothyfly</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,typography"></script>
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link
        href="https://fonts.googleapis.com/css2?family=Anton&amp;family=Inter:wght@300;400;500;600&amp;family=Oswald:wght@400;500;600&amp;display=swap"
        rel="stylesheet" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Outlined" rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;700&amp;family=Inter:wght@300;400;500;600&amp;display=swap"
        rel="stylesheet" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet" />
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        primary: "#1a1a1a", // Deep black for primary actions
                        "background-light": "#ffffff",
                        "background-dark": "#0f0f0f",
                        "surface-light": "#f9f9f9",
                        "surface-dark": "#1a1a1a",
                        "text-light": "#111111",
                        "text-dark": "#eeeeee",
                        "border-light": "#e5e5e5",
                        "border-dark": "#333333",
                        accent: "#cc0000", // Red accent for badges/notification
                    },
                    fontFamily: {
                        display: ["'Anton'", "sans-serif"], // Strong street style
                        body: ["'Inter'", "sans-serif"], // Clean minimalist
                        heading: ["'Oswald'", "sans-serif"], // Secondary headings
                    },
                    borderRadius: {
                        DEFAULT: "4px",
                    },
                },
            },
        };
    </script>
    <style>
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }

        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
</head>

<body
    class="bg-background-light dark:bg-background-dark text-text-light dark:text-text-dark font-body antialiased transition-colors duration-200 pb-20 lg:pb-0">
    <!-- Header Component (loaded dynamically) -->
    <div id="header-placeholder"></div>

    <div class="max-w-7xl mx-auto px-4 py-4 text-xs text-gray-500 dark:text-gray-400">
        <a class="hover:text-black dark:hover:text-white" href="#">Home</a>
        <span class="mx-2">/</span>
        <a class="hover:text-black dark:hover:text-white" href="#">Products</a>
        <span class="mx-2">/</span>
        <span class="text-black dark:text-white">I LIKE CARS MORE THAN PEOPLE - BLACK</span>
    </div>
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 lg:py-10">
        <div class="lg:grid lg:grid-cols-2 lg:gap-x-12 xl:gap-x-16">
            <div class="flex flex-col-reverse lg:flex-row gap-4 mb-10 lg:mb-0">
                <div class="flex lg:flex-col gap-3 overflow-x-auto lg:overflow-visible no-scrollbar">
                    <button
                        class="thumbnail-btn flex-shrink-0 w-20 h-20 border border-black dark:border-white p-1 transition-all">
                        <img alt="Black T-shirt front thumbnail"
                            class="w-full h-full object-contain bg-surface-light dark:bg-surface-dark"
                            src="https://lh3.googleusercontent.com/aida-public/AB6AXuCKOcAEFlsvqmHB70CqXMohFCMIgXpdsxjPDAIeZ3kxauvQoolZX3AWtYFrUHqIFjX8t8BsEuugi-QFI46hZQnGm_e87fJMCxNSdc-v0-ev9kAp8C6J1cGPQv7U6i59gIFVgAqR8wtvGX047Xt-7sjGSN3uhR2eN63qt9SSGu4RXiGPii6tMNUNiyVs2yk-OccEZ7Ma36ZRrZvDQ0VcGhuq0QOwx03fxaeddqhDWqNxCrDHVafZ717HB8m6Xtw58vYcjRubevlmMXO2" />
                    </button>
                    <button
                        class="thumbnail-btn flex-shrink-0 w-20 h-20 border border-transparent hover:border-gray-300 dark:hover:border-gray-600 p-1 transition-all">
                        <img alt="Black T-shirt back thumbnail"
                            class="w-full h-full object-contain bg-surface-light dark:bg-surface-dark"
                            src="https://lh3.googleusercontent.com/aida-public/AB6AXuBevRnn74D-yyEr9dZdT8-q0-oH5LIB4Wo0fpFU0A974tQTOQ5Bs4Y9WxAtPIgvWO4HQQ51QQFNrVRXimWKeLQczLR8gIS9nGTcu4VQgBoxZxv-GzCv1eSv9RfQkq4y39-H6wiAr0z9oKJRKYU250yDay4zm4l1tG8ikrdNLnFJ3goIJNyVu8PjVYsTIkgwCLmLJoUNO9q3iDEbmQTLMV3OqOu77rLwDUzgVhtHM_m0uDxs8dB8VTVN6_ErkihUX4L4EO15ZZEuxHsV" />
                    </button>
                    <button
                        class="thumbnail-btn flex-shrink-0 w-20 h-20 border border-transparent hover:border-gray-300 dark:hover:border-gray-600 p-1 transition-all">
                        <img alt="Black T-shirt back thumbnail"
                            class="w-full h-full object-contain bg-surface-light dark:bg-surface-dark"
                            src="https://lh3.googleusercontent.com/aida-public/AB6AXuAUNnCWdH2xMeia7uqV5Efuagx1zCnY7G1VyCtz5kM2RAQ0CORzcS4k9NgrzyQxVRRs1iFyVVP47to0Wdc0zsIGl-1cv6KocuPKtcb-Qb9uIpbtnLWeV_q5INCTC3BLq3Ky0Zmc15a1QWmX4g60WTIQ7nIks0RFf7nNFrsCyOCVOvhk8Bzg40z8Av_N4DMoExyoar-QUVuHqdvDyE5g_ZjLshsPZEhX-n0pPdBLoCKVPdhStyqTeTsAq_JOtp4oCbjO6fqizXhxLkLm" />
                    </button>
                    <button
                        class="thumbnail-btn flex-shrink-0 w-20 h-20 border border-transparent hover:border-gray-300 dark:hover:border-gray-600 p-1 transition-all">
                        <img alt="Black T-shirt detail thumbnail"
                            class="w-full h-full object-contain bg-surface-light dark:bg-surface-dark"
                            src="https://lh3.googleusercontent.com/aida-public/AB6AXuBdUZ-ps-BJ4CqRvefG47_YnwWTNgbaHGNCGsyPNcMAs2CQ5EhTisjPK3TLhC2MAMWnKBjFFUOMpc9DOf3wv-FJz2PcjaK3Jv5nqlrU72_K-6DxHZuQ2IgpgMMr0fH1xr5kfjP82E7wpIOPT4JOJiWkmSC1AUekkQTvS7sYuLx23U-p2eYQQfNQaWk6vGnylGyoAt0qN3Tc7ydxY3fnv1T0T1mRat2b65Os-NB4Qik2lgsCQLXQoI0D_GDkgm2iW4gPDUSt_KkL-B6i" />
                    </button>
                </div>
                <div
                    class="flex-1 relative aspect-[4/5] lg:aspect-square bg-surface-light dark:bg-surface-dark rounded-lg overflow-hidden group cursor-zoom-in">
                    <img id="main-product-image" alt="Black T-shirt with white graphic car print"
                        class="w-full h-full object-contain object-center group-hover:scale-105 transition-transform duration-500"
                        src="https://lh3.googleusercontent.com/aida-public/AB6AXuCKOcAEFlsvqmHB70CqXMohFCMIgXpdsxjPDAIeZ3kxauvQoolZX3AWtYFrUHqIFjX8t8BsEuugi-QFI46hZQnGm_e87fJMCxNSdc-v0-ev9kAp8C6J1cGPQv7U6i59gIFVgAqR8wtvGX047Xt-7sjGSN3uhR2eN63qt9SSGu4RXiGPii6tMNUNiyVs2yk-OccEZ7Ma36ZRrZvDQ0VcGhuq0QOwx03fxaeddqhDWqNxCrDHVafZ717HB8m6Xtw58vYcjRubevlmMXO2" />
                    <div class="absolute top-4 right-4 flex gap-2">
                        <button id="share-btn"
                            class="p-2 rounded-full bg-white/80 dark:bg-black/50 hover:bg-white dark:hover:bg-black transition-colors">
                            <span class="material-icons-outlined text-xl">share</span>
                        </button>
                        <button id="favorite-btn" data-id="detail-1" data-name="I Like Cars More Than People - Black"
                            data-price="1499" data-original-price="2499" data-offer="SAVE 40%"
                            data-image="https://lh3.googleusercontent.com/aida-public/AB6AXuCKOcAEFlsvqmHB70CqXMohFCMIgXpdsxjPDAIeZ3kxauvQoolZX3AWtYFrUHqIFjX8t8BsEuugi-QFI46hZQnGm_e87fJMCxNSdc-v0-ev9kAp8C6J1cGPQv7U6i59gIFVgAqR8wtvGX047Xt-7sjGSN3uhR2eN63qt9SSGu4RXiGPii6tMNUNiyVs2yk-OccEZ7Ma36ZRrZvDQ0VcGhuq0QOwx03fxaeddqhDWqNxCrDHVafZ717HB8m6Xtw58vYcjRubevlmMXO2"
                            class="wishlist-btn p-2 rounded-full bg-white/80 dark:bg-black/50 hover:bg-white dark:hover:bg-black transition-colors">
                            <span class="material-icons-outlined text-xl">favorite_border</span>
                        </button>
                    </div>
                </div>
            </div>
            <div class="lg:pl-6">
                <h1 class="font-heading font-bold text-2xl lg:text-3xl uppercase leading-tight mb-4">
                    I Like Cars More Than People - Black
                </h1>
                <div class="flex flex-col items-start gap-1 lg:flex-row lg:items-end lg:gap-3 mb-6">
                    <span id="product-price" class="text-2xl font-bold font-heading">Rs. 1,499.00</span>
                    <span class="text-sm text-gray-500 line-through mb-1">Rs. 2,499.00</span>
                    <span class="text-xs font-bold text-accent mb-1 border border-accent px-1.5 py-0.5 rounded">SAVE
                        40%</span>
                </div>
                <div class="prose dark:prose-invert prose-sm text-gray-600 dark:text-gray-300 mb-8 font-light">
                    <p>
                        Please note: The sizing has been updated. Kindly refer to the size
                        chart before placing your order.
                    </p>
                </div>
                <div class="mb-6">
                    <h3 class="text-sm font-semibold uppercase tracking-wide mb-3">
                        Color:
                        <span id="color-label-value" class="font-normal text-gray-500 dark:text-gray-400">Black</span>
                    </h3>
                    <div class="flex flex-wrap gap-3">
                        <button data-color="Black"
                            class="color-btn w-12 h-12 rounded border-2 border-black dark:border-white p-0.5 relative">
                            <img alt="Black" class="w-full h-full object-cover bg-gray-100"
                                src="https://lh3.googleusercontent.com/aida-public/AB6AXuCKOcAEFlsvqmHB70CqXMohFCMIgXpdsxjPDAIeZ3kxauvQoolZX3AWtYFrUHqIFjX8t8BsEuugi-QFI46hZQnGm_e87fJMCxNSdc-v0-ev9kAp8C6J1cGPQv7U6i59gIFVgAqR8wtvGX047Xt-7sjGSN3uhR2eN63qt9SSGu4RXiGPii6tMNUNiyVs2yk-OccEZ7Ma36ZRrZvDQ0VcGhuq0QOwx03fxaeddqhDWqNxCrDHVafZ717HB8m6Xtw58vYcjRubevlmMXO2" />
                        </button>
                        <button data-color="White"
                            class="color-btn w-12 h-12 rounded border-2 border-transparent hover:border-gray-300 p-0.5 relative">
                            <img alt="White" class="w-full h-full object-cover bg-gray-100"
                                src="https://lh3.googleusercontent.com/aida-public/AB6AXuASt0aF5WxFLdU2RuJNkTIA3--nuXmw5wL9nxUeSIdUxKt9Vnw5DjgDOXkof_JwtWb_CIs3UwyyZb89PL1UJvwtaxNbFazbqDDe5R8auGzn-WALoNCDZbawYz3pHgF5EOlSviLuFzrkXE_UfVg4-l66i5GOdH_4vV1OaIL_QOrKu4iKVOO9aUJLkKb9VDDt0yPNN6BE5nkPK0plC0ngzQrK6p9ErmZ1mXnCqS1l4qxcNjzGKuM2bBRKmuCoiUvayZEPnyr6EzbgnCub" />
                        </button>
                        <button data-color="Navy Blue"
                            class="color-btn w-12 h-12 rounded border-2 border-transparent hover:border-gray-300 p-0.5 relative">
                            <img alt="Navy Blue" class="w-full h-full object-cover bg-gray-100"
                                src="https://lh3.googleusercontent.com/aida-public/AB6AXuB5QHG0v8WTfRi_KbvaTQDYubV9uCIeFm6uSa-M2QiHE7KXkqQbeJGyjtM6zqklNGG0Umc73ovzgNWGWZwbx2gvg4dYrlWWKjW2S16BWyDYZWhBzTUR6-z8hL_8J96aPiBj-mjRkKRPfTwa98IN6p4-mClVL7gf5HFLL2z-GMRbyJ4_wmVJ0FSJhWXoZ-v4xGeANONWvripOOIOChWMI_UlNKCO4MEjQUfV7-02KEwGRUNjG5mkq83Qz6JYf262a0tZegX0Q3MpQHGu" />
                        </button>
                        <button data-color="Olive Green"
                            class="color-btn w-12 h-12 rounded border-2 border-transparent hover:border-gray-300 p-0.5 relative">
                            <img alt="Olive Green" class="w-full h-full object-cover bg-gray-100"
                                src="https://lh3.googleusercontent.com/aida-public/AB6AXuCj2q4NbxAjFOr63vuTCRmNPSRPwt2mDxysi6lzSTEH6lzNDUVmdihyc7mireFDUXel9eIcRxzCOb8SQDi8m4UEVqnhGAl8HNPmPVt2ZPZBB-JIuaBSmKjZyXsyFXe0Zi2KqDGADSMlZWn7_szBYnBsxqWBcZLf6xxTrxjQfLWuoM9XaSm6AEEfOAnOyxB1IvpFAIG-41N9sGjJIbH8H1ejnK_1Vvlg3YAtCVE5GXFrz-wwVwYG5QPOOjZbJHxKaA6UMg2HOXeAxRPm" />
                        </button>
                        <button data-color="Maroon"
                            class="color-btn w-12 h-12 rounded border-2 border-transparent hover:border-gray-300 p-0.5 relative">
                            <img alt="Maroon" class="w-full h-full object-cover bg-gray-100"
                                src="https://lh3.googleusercontent.com/aida-public/AB6AXuDGWrAuc-vNuO2OTjCBsh5z_yK-OTcsU2i0Xlob7roXg8FIKrELP8Sz87W2DhzOSqXfeh9XKD0UURO2JkMJe5XEUXiu2z0BeJXpDuoqfh_HRKlhMyPiSZJ59B3p2cWww6WI52t0XVC5SIhn2c_ID_IHBqWG9ffOzDIyH9yJvVtfFIc4CikCl_W4q42XtCsoCDnfi9hDVHqsaSi3oSLphWTrpUTRtpGQC8GVcEDvpo9ERRCeFTWuGaf3iL9HyKQzrkghdCrFdRdoESVq" />
                        </button>
                        <!-- Disabled Color Example -->
                        <button disabled data-color="Heather Grey (Out of Stock)"
                            class="color-btn w-12 h-12 rounded border-2 border-transparent p-0.5 relative cursor-not-allowed opacity-50">
                            <img alt="Heather Grey" class="w-full h-full object-cover bg-gray-100 grayscale"
                                src="https://lh3.googleusercontent.com/aida-public/AB6AXuASt0aF5WxFLdU2RuJNkTIA3--nuXmw5wL9nxUeSIdUxKt9Vnw5DjgDOXkof_JwtWb_CIs3UwyyZb89PL1UJvwtaxNbFazbqDDe5R8auGzn-WALoNCDZbawYz3pHgF5EOlSviLuFzrkXE_UfVg4-l66i5GOdH_4vV1OaIL_QOrKu4iKVOO9aUJLkKb9VDDt0yPNN6BE5nkPK0plC0ngzQrK6p9ErmZ1mXnCqS1l4qxcNjzGKuM2bBRKmuCoiUvayZEPnyr6EzbgnCub" />
                            <div class="absolute inset-0 flex items-center justify-center">
                                <div class="w-full border-t border-black dark:border-white transform -rotate-45"></div>
                            </div>
                        </button>
                    </div>
                </div>
                <div class="mb-8">
                    <div class="flex justify-between items-center mb-3">
                        <h3 class="text-sm font-semibold uppercase tracking-wide">
                            Size:
                            <span id="size-label-value" class="font-normal text-gray-500 dark:text-gray-400">L</span>
                        </h3>
                    </div>
                    <div class="grid grid-cols-6 gap-2 sm:gap-3">
                        <button
                            class="size-btn py-3 border border-gray-200 dark:border-gray-700 rounded text-gray-300 dark:text-gray-600 cursor-not-allowed text-sm font-medium relative"
                            disabled="">
                            S
                            <div class="absolute inset-0 flex items-center justify-center">
                                <div class="w-full border-t border-gray-300 dark:border-gray-600 transform -rotate-45">
                                </div>
                            </div>
                        </button>
                        <button
                            class="size-btn py-3 border border-gray-300 dark:border-gray-600 rounded hover:border-black dark:hover:border-white text-sm font-medium transition-colors">
                            M
                        </button>
                        <button
                            class="size-btn py-3 bg-black dark:bg-white text-white dark:text-black border border-black dark:border-white rounded text-sm font-bold shadow-md">
                            L
                        </button>
                        <button
                            class="size-btn py-3 border border-gray-300 dark:border-gray-600 rounded hover:border-black dark:hover:border-white text-sm font-medium transition-colors">
                            XL
                        </button>
                        <button
                            class="size-btn py-3 border border-gray-300 dark:border-gray-600 rounded hover:border-black dark:hover:border-white text-sm font-medium transition-colors">
                            2XL
                        </button>
                        <button
                            class="size-btn py-3 border border-gray-200 dark:border-gray-700 rounded text-gray-300 dark:text-gray-600 cursor-not-allowed text-sm font-medium relative"
                            disabled="">
                            3XL
                            <div class="absolute inset-0 flex items-center justify-center">
                                <div class="w-full border-t border-gray-300 dark:border-gray-600 transform -rotate-45">
                                </div>
                            </div>
                        </button>
                    </div>
                </div>
                <div class="flex flex-col gap-4 mb-8">
                    <div class="flex gap-4">
                        <div
                            class="w-32 flex items-center justify-between border border-gray-300 dark:border-gray-600 rounded px-3 h-12">
                            <button id="quantity-btn-minus"
                                class="text-gray-500 hover:text-black dark:hover:text-white text-xl">
                                -
                            </button>
                            <span id="quantity-value" class="font-medium">1</span>
                            <button id="quantity-btn-plus"
                                class="text-gray-500 hover:text-black dark:hover:text-white text-xl">
                                +
                            </button>
                        </div>
                        <button id="add-to-cart-btn"
                            class="flex-1 bg-white dark:bg-black text-black dark:text-white border border-black dark:border-white h-12 rounded font-bold uppercase tracking-wide hover:bg-gray-50 dark:hover:bg-gray-900 transition-colors">
                            Add to Cart
                        </button>
                    </div>
                    <button
                        class="w-full bg-primary text-white h-14 rounded font-bold uppercase tracking-widest text-lg hover:opacity-90 transition-opacity shadow-lg">
                        Buy Now
                    </button>
                </div>
                <div
                    class="flex items-center gap-3 text-sm text-gray-700 dark:text-gray-300 bg-surface-light dark:bg-surface-dark p-4 rounded-lg">
                    <span class="material-icons-outlined text-xl">local_shipping</span>
                    <p class="font-medium">
                        Estimated Delivery:
                        <span id="delivery-date" class="font-bold">Loading...</span> (5-7
                        Business Days)
                    </p>
                </div>
                <div
                    class="flex items-center gap-3 text-sm text-gray-700 dark:text-gray-300 bg-surface-light dark:bg-surface-dark p-4 rounded-lg mt-3">
                    <span class="material-icons-outlined text-xl">sync_alt</span>
                    <p class="font-medium">Easy 5 day return</p>
                </div>
            </div>
        </div>
        <div class="mt-16 lg:mt-24 border-t border-gray-200 dark:border-gray-700 pt-10">
            <div class="flex space-x-8 border-b border-gray-200 dark:border-gray-700 mb-8 overflow-x-auto no-scrollbar">
                <button id="tab-description"
                    class="pb-4 border-b-2 border-black dark:border-white font-bold uppercase tracking-wide whitespace-nowrap transition-colors">
                    Product Description
                </button>
                <button id="tab-shipping"
                    class="pb-4 border-b-2 border-transparent text-gray-500 dark:text-gray-400 hover:text-black dark:hover:text-white font-medium uppercase tracking-wide whitespace-nowrap transition-colors">
                    Shipping &amp; Returns
                </button>
                <button id="tab-cancellation"
                    class="pb-4 border-b-2 border-transparent text-gray-500 dark:text-gray-400 hover:text-black dark:hover:text-white font-medium uppercase tracking-wide whitespace-nowrap transition-colors">
                    Cancellation
                </button>
            </div>
            <div id="content-description"
                class="prose dark:prose-invert max-w-none text-gray-600 dark:text-gray-300 font-light leading-relaxed">
                <p class="font-bold text-black dark:text-white">
                    Black - 240 Gsm French Terry Cotton Tshirt - HV013
                </p>
                <p>
                    Crafted from high-quality 240 Gsm French Terry cotton, this graphic
                    t-shirt is perfect for any casual occasion. With its soft and
                    comfortable fabric, this t-shirt ensures a perfect fit and lasting
                    comfort throughout the day. A must-have addition to any wardrobe.
                </p>
                <ul class="list-disc pl-5 space-y-2 mt-4">
                    <li>Heavyweight 240 GSM Fabric</li>
                    <li>Oversized fit (Drop Shoulder)</li>
                    <li>High density puff print graphics</li>
                    <li>100% Cotton French Terry</li>
                </ul>
            </div>
            <div id="content-shipping"
                class="hidden prose dark:prose-invert max-w-none text-gray-600 dark:text-gray-300 font-light leading-relaxed">
                <p class="font-bold text-black dark:text-white mb-2">
                    Shipping Policy
                </p>
                <p class="mb-4">
                    We offer free shipping on all orders over Rs. 2,999. Standard
                    delivery typically takes 5-7 business days. You will receive a
                    tracking number once your order has shipped.
                </p>

                <p class="font-bold text-black dark:text-white mb-2">
                    Return & Exchange Policy
                </p>
                <p>
                    We accept returns and exchanges within 7 days of delivery. Items
                    must be unworn, unwashed, and in their original condition with tags
                    attached. Please note that sale items are final sale and cannot be
                    returned.
                </p>
            </div>
            <div id="content-cancellation"
                class="hidden prose dark:prose-invert max-w-none text-gray-600 dark:text-gray-300 font-light leading-relaxed">
                <p class="font-bold text-black dark:text-white mb-2">
                    Cancellation Policy
                </p>
                <p>
                    Orders can be cancelled within 24 hours of placement. If the order
                    has already been shipped, it cannot be cancelled.
                </p>
                <p>
                    To request a cancellation, please contact our support team
                    immediately.
                </p>
            </div>
        </div>
        <section class="mt-20">
            <h2 class="font-display text-3xl lg:text-4xl uppercase text-center mb-10">
                You Might Also Like
            </h2>
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-8">
                <div class="group">
                    <div class="relative bg-card-light dark:bg-card-dark rounded-lg overflow-hidden mb-4">
                        <span
                            class="absolute top-2 left-2 bg-accent text-white text-[10px] font-bold px-2 py-0.5 uppercase tracking-wider rounded-sm z-10">Hot</span>
