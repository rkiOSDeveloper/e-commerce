<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <link rel="icon" href="images/clothyfly_favicon.jpg" />

  <title>Profile - Clothyfly</title>
  <script src="https://cdn.tailwindcss.com?plugins=forms,typography"></script>
  <link
    href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;700&amp;family=Inter:wght@300;400;500;600&amp;display=swap"
    rel="stylesheet" />
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons|Material+Icons+Outlined" rel="stylesheet" />
  <script>
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            primary: "#111111",
            "background-light": "#ffffff",
            "background-dark": "#121212",
            "card-light": "#f8f8f8",
            "card-dark": "#1e1e1e",
            accent: "#ef4444",
          },
          fontFamily: {
            display: ["Oswald", "sans-serif"],
            sans: ["Inter", "sans-serif"],
          },
          borderRadius: {
            DEFAULT: "0.5rem",
          },
        },
      },
    };
  </script>
  <style>
    .hide-scrollbar::-webkit-scrollbar {
      display: none;
    }

    .hide-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
  </style>
</head>

<body
  class="bg-background-light dark:bg-background-dark text-gray-900 dark:text-gray-100 font-sans transition-colors duration-200 pb-10 lg:pb-0 flex flex-col min-h-screen">
  <!-- Header Component (loaded dynamically) -->
  <div id="header-placeholder"></div>

  <main class="flex-grow pb-20 bg-gray-50 dark:bg-background-dark pt-8">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Tabs -->
      <div class="border-b border-gray-200 dark:border-gray-800 mb-8">
        <nav class="-mb-px flex space-x-8" aria-label="Tabs">
          <a href="#"
            class="border-red-500 text-red-600 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm tracking-wider">ALL</a>
          <a href="#"
            class="border-transparent text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 hover:border-gray-300 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm tracking-wider">ONGOING</a>
          <a href="#"
            class="border-transparent text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 hover:border-gray-300 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm tracking-wider">DELIVERED</a>
          <a href="#"
            class="border-transparent text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 hover:border-gray-300 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm tracking-wider">CANCELLED</a>
        </nav>
      </div>

      <!-- Order List -->
      <div class="space-y-8">

        <!-- Order 1: Confirmed -->
        <div
          class="bg-white dark:bg-card-dark rounded-xl border border-gray-100 dark:border-gray-800 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
          <!-- Header -->
          <div
            class="px-6 py-4 border-b border-gray-100 dark:border-gray-800 flex flex-wrap justify-between items-center bg-gray-50/50 dark:bg-gray-800/30 gap-4">
            <div class="flex items-center gap-6">
              <div>
                <span
                  class="text-xs text-gray-500 dark:text-gray-400 font-bold uppercase tracking-wider block mb-0.5">Order
                  ID</span>
                <span class="text-base font-bold text-gray-900 dark:text-white">#CF-89234</span>
              </div>
              <div class="h-8 w-px bg-gray-200 dark:bg-gray-700 hidden sm:block"></div>
              <div>
                <span
                  class="text-xs text-gray-500 dark:text-gray-400 font-bold uppercase tracking-wider block mb-0.5">Date
                  Placed</span>
                <span class="text-base font-medium text-gray-900 dark:text-white">Oct 12, 2023</span>
              </div>
            </div>
            <span
              class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400">
              Confirmed
            </span>
          </div>

          <!-- Body -->
          <div class="p-6">
            <div class="flex gap-4 sm:gap-6">
              <!-- Product Image -->
              <div
                class="w-20 h-24 sm:w-24 sm:h-32 bg-gray-100 dark:bg-gray-800 rounded-lg overflow-hidden shrink-0 border border-gray-200 dark:border-gray-700">
                <img src="https://images.unsplash.com/photo-1556905055-8f358a7a47b2?auto=format&fit=crop&w=300&q=80"
                  class="w-full h-full object-cover">
              </div>
              <!-- Product Details -->
              <div class="flex-grow">
                <h4 class="text-lg font-bold text-gray-900 dark:text-white mb-2 line-clamp-1">Oversized Premium Hoodie
                </h4>
                <div class="flex flex-wrap gap-4 text-sm text-gray-500 dark:text-gray-400 mb-3">
                  <p><span class="font-medium text-gray-700 dark:text-gray-300">Color:</span> Black</p>
                  <p><span class="font-medium text-gray-700 dark:text-gray-300">Size:</span> M</p>
                  <p><span class="font-medium text-gray-700 dark:text-gray-300">Qty:</span> 1</p>
                </div>
                <p class="text-base font-bold text-gray-900 dark:text-white">Rs. 2,499</p>
              </div>
            </div>

            <!-- Additional Items Indicator -->
            <div class="mt-4 flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 pl-1">
              <span class="material-icons text-base">layers</span>
              <span>+ 1 more item in this order</span>
            </div>
          </div>

          <!-- Footer -->
          <div
            class="px-6 py-4 bg-gray-50/50 dark:bg-gray-800/30 flex flex-wrap justify-between items-center gap-4 border-t border-gray-100 dark:border-gray-800">
            <div>
              <span
                class="text-xs text-gray-500 dark:text-gray-400 uppercase font-bold tracking-wider block mb-0.5">Total
                Amount</span>
              <p class="text-xl font-bold text-gray-900 dark:text-white">Rs. 3,599</p>
            </div>
            <div>
              <button onclick="openCancelPopup()"
                class="px-6 py-2.5 rounded-full border border-red-200 bg-red-50 text-red-600 dark:border-red-900/50 dark:bg-red-900/20 dark:text-red-400 text-xs font-bold tracking-wider hover:bg-red-100 dark:hover:bg-red-900/40 transition-colors uppercase">
                Cancel Order
              </button>
            </div>
          </div>
        </div>

        <!-- Order 2: In Transit -->
        <div
          class="bg-white dark:bg-card-dark rounded-xl border border-gray-100 dark:border-gray-800 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
          <!-- Header -->
          <div
            class="px-6 py-4 border-b border-gray-100 dark:border-gray-800 flex flex-wrap justify-between items-center bg-gray-50/50 dark:bg-gray-800/30 gap-4">
            <div class="flex items-center gap-6">
              <div>
                <span
                  class="text-xs text-gray-500 dark:text-gray-400 font-bold uppercase tracking-wider block mb-0.5">Order
                  ID</span>
                <span class="text-base font-bold text-gray-900 dark:text-white">#CF-89102</span>
              </div>
              <div class="h-8 w-px bg-gray-200 dark:bg-gray-700 hidden sm:block"></div>
              <div>
                <span
                  class="text-xs text-gray-500 dark:text-gray-400 font-bold uppercase tracking-wider block mb-0.5">Date
                  Placed</span>
                <span class="text-base font-medium text-gray-900 dark:text-white">Sept 28, 2023</span>
              </div>
            </div>
            <span
              class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400">
              In Transit
            </span>
          </div>

          <!-- Body -->
          <div class="p-6">
            <div class="flex gap-4 sm:gap-6">
              <!-- Product Image -->
              <div
                class="w-20 h-24 sm:w-24 sm:h-32 bg-gray-100 dark:bg-gray-800 rounded-lg overflow-hidden shrink-0 border border-gray-200 dark:border-gray-700">
                <img src="https://images.unsplash.com/photo-1517438476312-10d79c077509?auto=format&fit=crop&w=300&q=80"
                  class="w-full h-full object-cover">
              </div>
              <!-- Product Details -->
              <div class="flex-grow">
                <h4 class="text-lg font-bold text-gray-900 dark:text-white mb-2 line-clamp-1">Tactical Cargo Pants</h4>
                <div class="flex flex-wrap gap-4 text-sm text-gray-500 dark:text-gray-400 mb-3">
                  <p><span class="font-medium text-gray-700 dark:text-gray-300">Color:</span> Grey</p>
                  <p><span class="font-medium text-gray-700 dark:text-gray-300">Size:</span> 32</p>
                  <p><span class="font-medium text-gray-700 dark:text-gray-300">Qty:</span> 1</p>
                </div>
                <p class="text-base font-bold text-gray-900 dark:text-white">Rs. 1,899</p>
              </div>
            </div>
          </div>

          <!-- Footer -->
          <div
            class="px-6 py-4 bg-gray-50/50 dark:bg-gray-800/30 flex flex-wrap justify-between items-center gap-4 border-t border-gray-100 dark:border-gray-800">
            <div>
              <span
                class="text-xs text-gray-500 dark:text-gray-400 uppercase font-bold tracking-wider block mb-0.5">Total
                Amount</span>
              <p class="text-xl font-bold text-gray-900 dark:text-white">Rs. 1,899</p>
            </div>
            <div>
              <button
                class="px-6 py-2.5 rounded-full border border-gray-200 bg-white text-gray-900 dark:border-gray-700 dark:bg-gray-800 dark:text-white text-xs font-bold tracking-wider hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors uppercase">
                Track Package
              </button>
            </div>
          </div>
        </div>

        <!-- Order 3: Delivered -->
        <div
          class="bg-white dark:bg-card-dark rounded-xl border border-gray-100 dark:border-gray-800 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
          <!-- Header -->
          <div
            class="px-6 py-4 border-b border-gray-100 dark:border-gray-800 flex flex-wrap justify-between items-center bg-gray-50/50 dark:bg-gray-800/30 gap-4">
            <div class="flex items-center gap-6">
              <div>
                <span
                  class="text-xs text-gray-500 dark:text-gray-400 font-bold uppercase tracking-wider block mb-0.5">Order
                  ID</span>
                <span class="text-base font-bold text-gray-900 dark:text-white">#CF-88991</span>
              </div>
              <div class="h-8 w-px bg-gray-200 dark:bg-gray-700 hidden sm:block"></div>
              <div>
                <span
                  class="text-xs text-gray-500 dark:text-gray-400 font-bold uppercase tracking-wider block mb-0.5">Date
                  Placed</span>
                <span class="text-base font-medium text-gray-900 dark:text-white">Aug 15, 2023</span>
              </div>
            </div>
            <span
              class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300">
              Delivered
            </span>
          </div>

          <!-- Body -->
          <div class="p-6">
            <div class="flex gap-4 sm:gap-6">
              <!-- Product Image -->
              <div
                class="w-20 h-24 sm:w-24 sm:h-32 bg-gray-100 dark:bg-gray-800 rounded-lg overflow-hidden shrink-0 border border-gray-200 dark:border-gray-700">
                <img src="https://images.unsplash.com/photo-1595950653106-6c9ebd614d3a?auto=format&fit=crop&w=300&q=80"
                  class="w-full h-full object-cover">
              </div>
              <!-- Product Details -->
              <div class="flex-grow">
                <h4 class="text-lg font-bold text-gray-900 dark:text-white mb-2 line-clamp-1">Urban Street Sneakers</h4>
                <div class="flex flex-wrap gap-4 text-sm text-gray-500 dark:text-gray-400 mb-3">
                  <p><span class="font-medium text-gray-700 dark:text-gray-300">Color:</span> White/Black</p>
                  <p><span class="font-medium text-gray-700 dark:text-gray-300">Size:</span> 9</p>
                  <p><span class="font-medium text-gray-700 dark:text-gray-300">Qty:</span> 1</p>
                </div>
                <p class="text-base font-bold text-gray-900 dark:text-white">Rs. 3,999</p>
              </div>
            </div>

            <!-- Additional Items Indicator -->
            <div class="mt-4 flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 pl-1">
              <span class="material-icons text-base">layers</span>
              <span>+ 1 more item in this order</span>
            </div>
          </div>

          <!-- Footer -->
          <div
            class="px-6 py-4 bg-gray-50/50 dark:bg-gray-800/30 flex flex-wrap justify-between items-center gap-4 border-t border-gray-100 dark:border-gray-800">
            <div>
              <span
                class="text-xs text-gray-500 dark:text-gray-400 uppercase font-bold tracking-wider block mb-0.5">Total
                Amount</span>
              <p class="text-xl font-bold text-gray-900 dark:text-white">Rs. 4,499</p>
            </div>
            <div>
              <button onclick="openReturnPopup()"
                class="px-6 py-2.5 rounded-full border border-black dark:border-white text-black dark:text-white text-xs font-bold tracking-wider hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black transition-colors uppercase">
                Return Order
              </button>
            </div>
          </div>
        </div>

      </div>
    </div>
  </main>

  <footer class="bg-black text-white border-t border-gray-800 mt-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-12 text-center md:text-left">
        <div class="col-span-2 md:col-span-1">
          <a class="block mb-6 inline-block md:block" href="#">
            <img alt="Clothyfly" class="h-16 w-auto invert brightness-0 mx-auto md:mx-0"
              src="images/Clothyfly-light.svg" />
          </a>
          <p class="text-gray-400 text-sm italic">
            Dress Better. Feel Better.
          </p>
        </div>
        <div>
          <h4 class="font-bold text-sm uppercase mb-4 tracking-wider">
            Quick Links
          </h4>
          <ul class="space-y-2 text-sm text-gray-400">
            <li><a class="hover:text-white" href="#">Home</a></li>
            <li><a class="hover:text-white" href="#">Products</a></li>
            <li><a class="hover:text-white" href="#">About</a></li>
            <li><a class="hover:text-white" href="#">Contact</a></li>
            <li><a class="hover:text-white" href="wishlist.html">Wishlist</a></li>
          </ul>
        </div>
        <div>
          <h4 class="font-bold text-sm uppercase mb-4 tracking-wider">
            Company
          </h4>
          <ul class="space-y-2 text-sm text-gray-400">
            <li><a class="hover:text-white" href="#">Order Processing</a></li>
            <li><a class="hover:text-white" href="#">Privacy Policy</a></li>
            <li>
              <a class="hover:text-white" href="#">Refund &amp; Exchange Policy</a>
            </li>
            <li>
              <a class="hover:text-white" href="#">Terms and Conditions</a>
            </li>
          </ul>
        </div>
        <div class="col-span-2 md:col-span-1">
          <h4 class="font-bold text-sm uppercase mb-4 tracking-wider">
            Our Store
          </h4>
          <div class="flex space-x-4 justify-center md:justify-start">
            <a class="text-gray-400 hover:text-white transition-colors" href="#">
              <span class="material-icons text-xl">camera_alt</span>
            </a>
            <a class="text-gray-400 hover:text-white transition-colors" href="#">
              <span class="material-icons text-xl">facebook</span>
            </a>
            <a class="text-gray-400 hover:text-white transition-colors" href="#">
              <span class="material-icons text-xl">location_on</span>
            </a>
          </div>
        </div>
      </div>
      <div
        class="border-t border-gray-800 mt-12 pt-8 flex flex-col md:flex-row justify-between items-center text-xs text-gray-500">
        <p>
          &copy; <span id="copyright-year">2025</span> Clothyfly. All rights
          reserved.
        </p>
      </div>
    </div>
  </footer>
  <button id="scroll-to-top"
    class="fixed bottom-20 lg:bottom-6 right-6 bg-white text-black p-3 rounded-full shadow-xl hover:bg-gray-100 transition-all duration-300 z-50 opacity-0 invisible translate-y-4">
    <span class="material-icons text-xl">arrow_upward</span>
  </button>

  <!-- Mobile Menu Drawer (White Background) -->
  <!-- Mobile Menu Component (loaded dynamically) -->
  <div id="mobile-menu-placeholder"></div>

  <!-- Search Modal -->
  <div id="search-modal"
    class="fixed inset-0 z-[60] bg-white dark:bg-background-dark transform translate-y-full transition-transform duration-300 flex flex-col">
    <div class="p-4 border-b border-gray-100 dark:border-gray-800 flex justify-between items-center">
      <h2 class="text-lg font-medium text-gray-900 dark:text-white">
        Search our store
      </h2>
      <button onclick="toggleSearchModal()"
        class="text-gray-500 hover:text-black dark:text-gray-400 dark:hover:text-white focus:outline-none">
        <span class="material-icons text-2xl">close</span>
      </button>
    </div>
    <div class="p-4">
      <div class="relative mb-6">
        <input id="mobile-search-input" type="text" placeholder="Search products"
          class="w-full border border-gray-300 dark:border-gray-700 rounded-lg py-3 px-4 pl-4 pr-10 text-gray-900 dark:text-white bg-transparent focus:ring-1 focus:ring-black dark:focus:ring-white focus:border-transparent outline-none" />
        <button class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-400">
          <span class="material-icons text-xl">search</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Sticky Bottom Navigation (Mobile/Tablet) -->
  <div style="padding-bottom: calc(20px + env(safe-area-inset-bottom))"
    class="fixed bottom-0 left-0 right-0 bg-white dark:bg-black border-t border-gray-200 dark:border-gray-800 flex justify-between px-8 pt-3 z-30 lg:hidden">
    <a href="index.html"
      class="flex flex-col items-center justify-center text-gray-400 dark:text-gray-500 hover:text-black dark:hover:text-white transition-colors">
      <span class="material-icons text-2xl">home</span>
    </a>
    <a href="product_list.html"
      class="flex flex-col items-center justify-center text-gray-400 dark:text-gray-500 hover:text-black dark:hover:text-white transition-colors">
      <span class="material-icons text-2xl">grid_view</span>
    </a>
    <a href="cart.html"
      class="flex flex-col items-center justify-center text-gray-400 dark:text-gray-500 hover:text-black dark:hover:text-white transition-colors relative">
      <span class="material-icons text-2xl">shopping_bag</span>
      <span
        class="cart-count-badge absolute -top-1 -right-1 flex h-4 w-4 items-center justify-center rounded-full bg-red-600 dark:bg-white text-[10px] font-bold text-white dark:text-black hidden">0</span>
    </a>
    <button onclick="toggleSearchModal()"
      class="flex flex-col items-center justify-center text-gray-400 dark:text-gray-500 hover:text-black dark:hover:text-white transition-colors">
      <span class="material-icons text-2xl">search</span>
    </button>
  </div>
  <!-- Component Loader -->
  <script src="js/utils/component-loader.js"></script>
  <!-- Header Manager -->
  <script src="js/components/header.js"></script>
  <!-- Footer Manager -->
  <script src="js/components/footer.js"></script>
  <!-- Mobile Menu Manager -->
  <script src="js/components/mobile-menu.js"></script>
  <script>
    // Load header and footer components on page load
    document.addEventListener('DOMContentLoaded', async () => {
      const loader = new ComponentLoader();

      // Load header and footer components
      await loader.loadMultiple([
        { name: 'header', target: '#header-placeholder', method: 'replace' },
        { name: 'footer', target: '#footer-placeholder', method: 'replace' },
        { name: 'mobile-menu', target: '#mobile-menu-placeholder', method: 'replace' }
      ]);

      // Initialize header functionality after component is loaded
      const headerManager = new HeaderManager();
      await headerManager.init();

      // Initialize footer functionality after component is loaded
      const footerManager = new FooterManager();
      footerManager.init();

      // Initialize mobile menu functionality after component is loaded
      const mobileMenuManager = new MobileMenuManager();
      mobileMenuManager.init();
    });
  </script>

  <script src="js/common.js"></script>
  <script src="js/orders.js"></script>

  <!-- Return Order Popup -->
  <div id="return-popup" class="fixed inset-0 z-50 hidden">
    <!-- Backdrop -->
    <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" onclick="closeReturnPopup()"></div>

    <!-- Modal Content -->
    <div id="return-popup-content"
      class="absolute bottom-0 left-0 right-0 md:top-1/2 md:left-1/2 md:bottom-auto md:right-auto md:transform md:-translate-x-1/2 md:-translate-y-1/2 md:w-full md:max-w-lg bg-white dark:bg-card-dark rounded-t-3xl md:rounded-2xl shadow-2xl transition-transform duration-300 translate-y-full flex flex-col max-h-[90vh]">

      <!-- Header -->
      <div class="px-6 py-4 border-b border-gray-100 dark:border-gray-800 flex justify-between items-center shrink-0">
        <h3 class="text-lg font-bold text-gray-900 dark:text-white">Request Return</h3>
        <button onclick="closeReturnPopup()"
          class="p-2 -mr-2 text-gray-500 hover:text-black dark:text-gray-400 dark:hover:text-white rounded-full hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
          <span class="material-icons">close</span>
        </button>
      </div>

      <!-- Body (Scrollable) -->
      <div class="p-6 overflow-y-auto">
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-4 font-medium">Please select a reason for your return:</p>

        <div class="space-y-3 mb-6">
          <!-- Reason Option 1 -->
          <label class="cursor-pointer group block">
            <input type="radio" name="return_reason" class="peer sr-only" value="wrong_item">
            <div
              class="p-4 rounded-xl border-2 border-gray-100 dark:border-gray-700 hover:border-black dark:hover:border-white peer-checked:border-black dark:peer-checked:border-white peer-checked:bg-gray-50 dark:peer-checked:bg-gray-800/50 transition-all flex items-center justify-between">
              <span
                class="font-medium text-gray-700 dark:text-gray-200 group-hover:text-black dark:group-hover:text-white">Received
                wrong item</span>
              <div
                class="w-5 h-5 rounded-full border-2 border-gray-300 dark:border-gray-600 peer-checked:border-black dark:peer-checked:border-white peer-checked:bg-black dark:peer-checked:bg-white flex items-center justify-center">
                <span
                  class="material-icons text-[10px] text-white dark:text-black opacity-0 peer-checked:opacity-100 font-bold">check</span>
              </div>
            </div>
          </label>

          <!-- Reason Option 2 -->
          <label class="cursor-pointer group block">
            <input type="radio" name="return_reason" class="peer sr-only" value="defective">
            <div
              class="p-4 rounded-xl border-2 border-gray-100 dark:border-gray-700 hover:border-black dark:hover:border-white peer-checked:border-black dark:peer-checked:border-white peer-checked:bg-gray-50 dark:peer-checked:bg-gray-800/50 transition-all flex items-center justify-between">
              <span
                class="font-medium text-gray-700 dark:text-gray-200 group-hover:text-black dark:group-hover:text-white">Item
                defective or damaged</span>
              <div
                class="w-5 h-5 rounded-full border-2 border-gray-300 dark:border-gray-600 peer-checked:border-black dark:peer-checked:border-white peer-checked:bg-black dark:peer-checked:bg-white flex items-center justify-center">
                <span
                  class="material-icons text-[10px] text-white dark:text-black opacity-0 peer-checked:opacity-100 font-bold">check</span>
              </div>
            </div>
          </label>

          <!-- Reason Option 3 -->
          <label class="cursor-pointer group block">
            <input type="radio" name="return_reason" class="peer sr-only" value="quality">
            <div
              class="p-4 rounded-xl border-2 border-gray-100 dark:border-gray-700 hover:border-black dark:hover:border-white peer-checked:border-black dark:peer-checked:border-white peer-checked:bg-gray-50 dark:peer-checked:bg-gray-800/50 transition-all flex items-center justify-between">
              <span
                class="font-medium text-gray-700 dark:text-gray-200 group-hover:text-black dark:group-hover:text-white">Quality
                not as expected</span>
              <div
                class="w-5 h-5 rounded-full border-2 border-gray-300 dark:border-gray-600 peer-checked:border-black dark:peer-checked:border-white peer-checked:bg-black dark:peer-checked:bg-white flex items-center justify-center">
                <span
                  class="material-icons text-[10px] text-white dark:text-black opacity-0 peer-checked:opacity-100 font-bold">check</span>
              </div>
            </div>
          </label>

          <!-- Reason Option 4 -->
          <label class="cursor-pointer group block">
            <input type="radio" name="return_reason" class="peer sr-only" value="size_fit">
            <div
              class="p-4 rounded-xl border-2 border-gray-100 dark:border-gray-700 hover:border-black dark:hover:border-white peer-checked:border-black dark:peer-checked:border-white peer-checked:bg-gray-50 dark:peer-checked:bg-gray-800/50 transition-all flex items-center justify-between">
              <span
                class="font-medium text-gray-700 dark:text-gray-200 group-hover:text-black dark:group-hover:text-white">Size
                fit issue</span>
              <div
                class="w-5 h-5 rounded-full border-2 border-gray-300 dark:border-gray-600 peer-checked:border-black dark:peer-checked:border-white peer-checked:bg-black dark:peer-checked:bg-white flex items-center justify-center">
                <span
                  class="material-icons text-[10px] text-white dark:text-black opacity-0 peer-checked:opacity-100 font-bold">check</span>
              </div>
            </div>
          </label>

          <!-- Reason Option 5 -->
          <label class="cursor-pointer group block">
            <input type="radio" name="return_reason" class="peer sr-only" value="too_late">
            <div
              class="p-4 rounded-xl border-2 border-gray-100 dark:border-gray-700 hover:border-black dark:hover:border-white peer-checked:border-black dark:peer-checked:border-white peer-checked:bg-gray-50 dark:peer-checked:bg-gray-800/50 transition-all flex items-center justify-between">
              <span
                class="font-medium text-gray-700 dark:text-gray-200 group-hover:text-black dark:group-hover:text-white">Arrived
                too late</span>
              <div
                class="w-5 h-5 rounded-full border-2 border-gray-300 dark:border-gray-600 peer-checked:border-black dark:peer-checked:border-white peer-checked:bg-black dark:peer-checked:bg-white flex items-center justify-center">
                <span
                  class="material-icons text-[10px] text-white dark:text-black opacity-0 peer-checked:opacity-100 font-bold">check</span>
              </div>
            </div>
          </label>
        </div>

        <div class="mb-2">
          <label for="return_comment" class="block text-sm font-bold text-gray-900 dark:text-white mb-2">Additional
            Comments (Optional)</label>
          <textarea id="return_comment" rows="3"
            class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-gray-800/50 border-transparent focus:border-black dark:focus:border-white focus:bg-white dark:focus:bg-gray-800 focus:ring-0 text-sm transition-all resize-none placeholder-gray-400"
            placeholder="Tell us more about the issue..."></textarea>
        </div>
      </div>

      <!-- Footer -->
      <div class="p-6 border-t border-gray-100 dark:border-gray-800 flex gap-4 shrink-0">
        <button onclick="closeReturnPopup()"
          class="flex-1 py-3.5 text-sm font-bold border border-gray-200 dark:border-gray-700 text-gray-700 dark:text-white rounded-full hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors uppercase tracking-wider">
          Cancel
        </button>
        <button onclick="confirmReturn()"
          class="flex-1 py-3.5 text-sm font-bold bg-black text-white dark:bg-white dark:text-black rounded-full hover:opacity-90 transition-opacity uppercase tracking-wider shadow-lg">
          Confirm Return
        </button>
      </div>
    </div>
  </div>

  <!-- Cancel Order Popup -->
  <div id="cancel-popup" class="fixed inset-0 z-50 hidden">
    <!-- Backdrop -->
    <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" onclick="closeCancelPopup()"></div>

    <!-- Modal Content -->
    <div id="cancel-popup-content"
      class="absolute bottom-0 left-0 right-0 md:top-1/2 md:left-1/2 md:bottom-auto md:right-auto md:transform md:-translate-x-1/2 md:-translate-y-1/2 md:w-full md:max-w-lg bg-white dark:bg-card-dark rounded-t-3xl md:rounded-2xl shadow-2xl transition-transform duration-300 translate-y-full flex flex-col max-h-[90vh]">

      <!-- Header -->
      <div class="px-6 py-4 border-b border-gray-100 dark:border-gray-800 flex justify-between items-center shrink-0">
        <h3 class="text-lg font-bold text-gray-900 dark:text-white">Reason for Cancellation</h3>
        <button onclick="closeCancelPopup()"
          class="p-2 -mr-2 text-gray-500 hover:text-black dark:text-gray-400 dark:hover:text-white rounded-full hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
          <span class="material-icons">close</span>
        </button>
      </div>

      <!-- Body (Scrollable) -->
      <div class="p-6 overflow-y-auto">
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-4 font-medium">Please select a reason for cancellation:
        </p>

        <div class="space-y-3 mb-6">
          <!-- Reason Option 1 -->
          <label class="cursor-pointer group block">
            <input type="radio" name="cancel_reason" class="peer sr-only" value="incorrect_size">
            <div
              class="p-4 rounded-xl border-2 border-gray-100 dark:border-gray-700 hover:border-red-500 dark:hover:border-red-500 peer-checked:border-red-600 dark:peer-checked:border-red-500 peer-checked:bg-red-50 dark:peer-checked:bg-red-900/10 transition-all flex items-center justify-between">
              <span
                class="font-medium text-gray-700 dark:text-gray-200 group-hover:text-black dark:group-hover:text-white">Incorrect
                size ordered</span>
              <div
                class="w-5 h-5 rounded-full border-2 border-gray-300 dark:border-gray-600 peer-checked:border-red-600 dark:peer-checked:border-red-500 peer-checked:bg-red-600 dark:peer-checked:bg-red-500 flex items-center justify-center">
                <span
                  class="material-icons text-[10px] text-white opacity-0 peer-checked:opacity-100 font-bold">check</span>
              </div>
            </div>
          </label>

          <!-- Reason Option 2 -->
          <label class="cursor-pointer group block">
            <input type="radio" name="cancel_reason" class="peer sr-only" value="not_required">
            <div
              class="p-4 rounded-xl border-2 border-gray-100 dark:border-gray-700 hover:border-red-500 dark:hover:border-red-500 peer-checked:border-red-600 dark:peer-checked:border-red-500 peer-checked:bg-red-50 dark:peer-checked:bg-red-900/10 transition-all flex items-center justify-between">
              <span
                class="font-medium text-gray-700 dark:text-gray-200 group-hover:text-black dark:group-hover:text-white">Product
                not required anymore</span>
              <div
                class="w-5 h-5 rounded-full border-2 border-gray-300 dark:border-gray-600 peer-checked:border-red-600 dark:peer-checked:border-red-500 peer-checked:bg-red-600 dark:peer-checked:bg-red-500 flex items-center justify-center">
                <span
                  class="material-icons text-[10px] text-white opacity-0 peer-checked:opacity-100 font-bold">check</span>
              </div>
            </div>
          </label>

          <!-- Reason Option 3 -->
          <label class="cursor-pointer group block">
            <input type="radio" name="cancel_reason" class="peer sr-only" value="cash_issue">
            <div
              class="p-4 rounded-xl border-2 border-gray-100 dark:border-gray-700 hover:border-red-500 dark:hover:border-red-500 peer-checked:border-red-600 dark:peer-checked:border-red-500 peer-checked:bg-red-50 dark:peer-checked:bg-red-900/10 transition-all flex items-center justify-between">
              <span
                class="font-medium text-gray-700 dark:text-gray-200 group-hover:text-black dark:group-hover:text-white">Cash
                Issue</span>
              <div
                class="w-5 h-5 rounded-full border-2 border-gray-300 dark:border-gray-600 peer-checked:border-red-600 dark:peer-checked:border-red-500 peer-checked:bg-red-600 dark:peer-checked:bg-red-500 flex items-center justify-center">
                <span
                  class="material-icons text-[10px] text-white opacity-0 peer-checked:opacity-100 font-bold">check</span>
              </div>
            </div>
          </label>

          <!-- Reason Option 4 -->
          <label class="cursor-pointer group block">
            <input type="radio" name="cancel_reason" class="peer sr-only" value="mistake">
            <div
              class="p-4 rounded-xl border-2 border-gray-100 dark:border-gray-700 hover:border-red-500 dark:hover:border-red-500 peer-checked:border-red-600 dark:peer-checked:border-red-500 peer-checked:bg-red-50 dark:peer-checked:bg-red-900/10 transition-all flex items-center justify-between">
              <span
                class="font-medium text-gray-700 dark:text-gray-200 group-hover:text-black dark:group-hover:text-white">Ordered
                by mistake</span>
              <div
                class="w-5 h-5 rounded-full border-2 border-gray-300 dark:border-gray-600 peer-checked:border-red-600 dark:peer-checked:border-red-500 peer-checked:bg-red-600 dark:peer-checked:bg-red-500 flex items-center justify-center">
                <span
                  class="material-icons text-[10px] text-white opacity-0 peer-checked:opacity-100 font-bold">check</span>
              </div>
            </div>
          </label>

          <!-- Reason Option 5 -->
          <label class="cursor-pointer group block">
            <input type="radio" name="cancel_reason" class="peer sr-only" value="change_style">
            <div
              class="p-4 rounded-xl border-2 border-gray-100 dark:border-gray-700 hover:border-red-500 dark:hover:border-red-500 peer-checked:border-red-600 dark:peer-checked:border-red-500 peer-checked:bg-red-50 dark:peer-checked:bg-red-900/10 transition-all flex items-center justify-between">
              <span
                class="font-medium text-gray-700 dark:text-gray-200 group-hover:text-black dark:group-hover:text-white">Wants
                to change style/color</span>
              <div
                class="w-5 h-5 rounded-full border-2 border-gray-300 dark:border-gray-600 peer-checked:border-red-600 dark:peer-checked:border-red-500 peer-checked:bg-red-600 dark:peer-checked:bg-red-500 flex items-center justify-center">
                <span
                  class="material-icons text-[10px] text-white opacity-0 peer-checked:opacity-100 font-bold">check</span>
              </div>
            </div>
          </label>
        </div>

        <div class="mb-2">
          <label for="cancel_comment" class="block text-sm font-bold text-gray-900 dark:text-white mb-2">Additional
            Comments (Optional)</label>
          <textarea id="cancel_comment" rows="3"
            class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-gray-800/50 border-transparent focus:border-red-500 dark:focus:border-red-500 focus:bg-white dark:focus:bg-gray-800 focus:ring-0 text-sm transition-all resize-none placeholder-gray-400"
            placeholder="Tell us more about why you're cancelling..."></textarea>
        </div>
      </div>

      <!-- Footer -->
      <div class="p-6 border-t border-gray-100 dark:border-gray-800 flex gap-4 shrink-0">
        <button onclick="closeCancelPopup()"
          class="flex-1 py-3.5 text-sm font-bold border border-gray-200 dark:border-gray-700 text-gray-700 dark:text-white rounded-full hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors uppercase tracking-wider">
          Don't Cancel
        </button>
        <button onclick="confirmCancel()"
          class="flex-1 py-3.5 text-sm font-bold bg-red-600 text-white rounded-full hover:bg-red-700 transition-colors uppercase tracking-wider shadow-lg shadow-red-200 dark:shadow-none">
          Cancel Order
        </button>
      </div>
    </div>
  </div>

  <!-- Edit Profile Popup -->
  <div id="edit-profile-popup" class="fixed inset-0 z-50 hidden">
    <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" onclick="closeEditProfilePopup()"></div>
    <div
      class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-full max-w-lg bg-white dark:bg-card-dark p-6 rounded-lg shadow-2xl">
      <div class="flex justify-between items-center mb-6">
        <h2 class="text-xl font-bold text-gray-900 dark:text-white">Edit profile</h2>
        <button onclick="closeEditProfilePopup()" class="text-gray-500 hover:text-black dark:hover:text-white">
          <span class="material-icons">close</span>
        </button>
      </div>

      <div class="grid grid-cols-2 gap-4 mb-4">
        <div>
          <label class="block text-xs text-gray-500 dark:text-gray-400 mb-1">First name</label>
          <input type="text" id="edit-firstname"
            class="w-full text-sm border-gray-300 rounded focus:ring-black focus:border-black dark:bg-gray-800 dark:border-gray-700 dark:text-white">
        </div>
        <div>
          <label class="block text-xs text-gray-500 dark:text-gray-400 mb-1">Last name</label>
          <input type="text" id="edit-lastname"
            class="w-full text-sm border-gray-300 rounded focus:ring-black focus:border-black dark:bg-gray-800 dark:border-gray-700 dark:text-white">
        </div>
      </div>

      <div class="mb-6">
        <label class="block text-xs text-gray-500 dark:text-gray-400 mb-1">Email</label>
        <input type="email" id="edit-email"
          class="w-full text-sm border-gray-300 rounded focus:ring-black focus:border-black dark:bg-gray-800 dark:border-gray-700 dark:text-white">
        <p class="text-xs text-gray-500 mt-1">This email is used for sign-in and order updates.</p>
      </div>

      <div class="flex justify-end gap-3">
        <button onclick="closeEditProfilePopup()"
          class="px-4 py-2 text-sm font-medium text-blue-600 border border-gray-200 rounded hover:bg-gray-50 dark:border-gray-700 dark:hover:bg-gray-800 transition-colors">Cancel</button>
        <button onclick="saveProfile()"
          class="px-4 py-2 text-sm font-medium text-black bg-gray-100 rounded hover:bg-gray-200 dark:bg-gray-700 dark:text-white dark:hover:bg-gray-600 transition-colors">Save</button>
      </div>
    </div>
  </div>
</body>

<!-- Add Address Popup -->
<div id="add-address-popup" class="fixed inset-0 z-50 hidden">
  <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" onclick="closeAddAddressPopup()"></div>
  <div
    class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-full max-w-2xl bg-white dark:bg-card-dark p-6 rounded-lg shadow-2xl max-h-[90vh] overflow-y-auto">
    <div class="flex justify-between items-center mb-6">
      <h2 id="add-address-popup-title" class="text-xl font-bold text-gray-900 dark:text-white">Add address</h2>
      <button onclick="closeAddAddressPopup()" class="text-gray-500 hover:text-black dark:hover:text-white">
        <span class="material-icons">close</span>
      </button>
    </div>

    <input type="hidden" id="add-address-id">

    <div class="mb-4">
      <label class="flex items-center space-x-2 cursor-pointer">
        <input type="checkbox" id="add-address-default"
          class="rounded border-gray-300 text-black focus:ring-black dark:bg-gray-800 dark:border-gray-700">
        <span class="text-sm text-gray-700 dark:text-gray-300">This is my default address</span>
      </label>
    </div>



    <div class="grid grid-cols-2 gap-4 mb-4">
      <div>
        <label class="block text-xs text-gray-500 dark:text-gray-400 mb-1">First name</label>
        <input type="text" id="add-address-firstname"
          class="w-full text-sm border-gray-300 rounded focus:ring-black focus:border-black dark:bg-gray-800 dark:border-gray-700 dark:text-white">
      </div>
      <div>
        <label class="block text-xs text-gray-500 dark:text-gray-400 mb-1">Last name</label>
        <input type="text" id="add-address-lastname"
          class="w-full text-sm border-gray-300 rounded focus:ring-black focus:border-black dark:bg-gray-800 dark:border-gray-700 dark:text-white">
      </div>
    </div>

    <div class="mb-4">
      <label class="block text-xs text-gray-500 dark:text-gray-400 mb-1">Address</label>
      <input type="text" id="add-address-line1"
        class="w-full text-sm border-gray-300 rounded focus:ring-black focus:border-black dark:bg-gray-800 dark:border-gray-700 dark:text-white">
    </div>

    <div class="mb-4">
      <label class="block text-xs text-gray-500 dark:text-gray-400 mb-1">Apartment, suite, etc (optional)</label>
      <input type="text" id="add-address-line2"
        class="w-full text-sm border-gray-300 rounded focus:ring-black focus:border-black dark:bg-gray-800 dark:border-gray-700 dark:text-white">
    </div>

    <div class="grid grid-cols-3 gap-4 mb-4">
      <div>
        <label class="block text-xs text-gray-500 dark:text-gray-400 mb-1">City</label>
        <input type="text" id="add-address-city"
          class="w-full text-sm border-gray-300 rounded focus:ring-black focus:border-black dark:bg-gray-800 dark:border-gray-700 dark:text-white">
      </div>
      <div>
        <label class="block text-xs text-gray-500 dark:text-gray-400 mb-1">State</label>
        <select id="add-address-state"
          class="w-full text-sm border-gray-300 rounded focus:ring-black focus:border-black dark:bg-gray-800 dark:border-gray-700 dark:text-white">
          <option value="">Select State</option>
          <option value="Gujarat">Gujarat</option>
          <option value="Maharashtra">Maharashtra</option>
          <option value="Delhi">Delhi</option>
          <option value="Andaman and Nicobar Islands">Andaman and Nicobar Islands</option>
        </select>
      </div>
      <div>
        <label class="block text-xs text-gray-500 dark:text-gray-400 mb-1">PIN code</label>
        <input type="text" id="add-address-pincode"
          class="w-full text-sm border-gray-300 rounded focus:ring-black focus:border-black dark:bg-gray-800 dark:border-gray-700 dark:text-white">
      </div>
    </div>

    <div class="mb-6">
      <label class="block text-xs text-gray-500 dark:text-gray-400 mb-1">Phone</label>
      <div class="relative">
        <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
          <img src="https://flagcdn.com/w20/in.png" class="w-5 h-auto">
          <span class="text-gray-500 text-sm ml-2">+91</span>
          <div class="h-5 w-px bg-gray-300 ml-3"></div>
        </div>
        <input type="tel" id="add-address-phone"
          class="w-full text-sm border-gray-300 rounded pl-24 focus:ring-black focus:border-black dark:bg-gray-800 dark:border-gray-700 dark:text-white"
          placeholder="Mobile number">
      </div>
    </div>

    <div class="flex justify-between items-center mt-6">
      <button id="delete-address-btn" onclick="deleteAddress()"
        class="hidden text-red-600 font-medium text-sm hover:text-red-700 transition-colors">Delete</button>
      <div class="flex gap-3 ml-auto">
        <button onclick="closeAddAddressPopup()"
          class="px-4 py-2 text-sm font-medium text-blue-600 border border-gray-200 rounded hover:bg-gray-50 dark:border-gray-700 dark:hover:bg-gray-800 transition-colors">Cancel</button>
        <button onclick="saveNewAddress()"
          class="px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded hover:bg-blue-700 transition-colors">Save</button>
      </div>
    </div>
  </div>
</div>

<!-- Delete Confirmation Popup -->
<div id="delete-confirmation-popup" class="fixed inset-0 z-[60] hidden">
  <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" onclick="closeDeleteConfirmationPopup()"></div>
  <div
    class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-full max-w-sm bg-white dark:bg-card-dark p-6 rounded-lg shadow-2xl">
    <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2">Delete Address</h3>
    <p class="text-sm text-gray-500 dark:text-gray-400 mb-6">Are you sure you want to delete this address? This action
      cannot be undone.</p>

    <div class="flex justify-end gap-3">
      <button onclick="closeDeleteConfirmationPopup()"
        class="px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded hover:bg-gray-200 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-gray-700 transition-colors">Cancel</button>
      <button onclick="confirmDeleteAddress()"
        class="px-4 py-2 text-sm font-medium text-white bg-red-600 rounded hover:bg-red-700 transition-colors">Delete</button>
    </div>
  </div>
</div>

<!-- Warning Popup -->
<div id="warning-popup" class="fixed inset-0 z-[70] hidden">
  <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" onclick="closeWarningPopup()"></div>
  <div
    class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-full max-w-sm bg-white dark:bg-card-dark p-6 rounded-lg shadow-2xl text-center">
    <div class="w-12 h-12 bg-yellow-100 rounded-full flex items-center justify-center mx-auto mb-4">
      <span class="material-icons text-yellow-600 text-2xl">warning_amber</span>
    </div>
    <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2">Attention</h3>
    <p id="warning-popup-message" class="text-sm text-gray-500 dark:text-gray-400 mb-6">Something went wrong.</p>

    <button onclick="closeWarningPopup()"
      class="w-full px-4 py-2 text-sm font-medium text-white bg-black dark:bg-white dark:text-black rounded hover:opacity-90 transition-opacity">OK</button>
  </div>
</div>

<!-- Component Loader -->
<script src="js/utils/component-loader.js"></script>
<!-- Header Manager -->
<script src="js/components/header.js"></script>
<script>
  // Load header component on page load
  document.addEventListener('DOMContentLoaded', async () => {
    const loader = new ComponentLoader();
    await loader.load('header', '#header-placeholder', 'replace');

    // Initialize header functionality after component is loaded
    const headerManager = new HeaderManager();
    await headerManager.init();
  });
</script>

</body>

</html>