<!doctype html>
<html class="scroll-smooth" lang="en">

<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <link rel="icon" href="images/clothyfly_favicon.jpg" />

  <title>Clothyfly</title>
  <script src="https://cdn.tailwindcss.com?plugins=forms,typography"></script>
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&amp;family=Oswald:wght@400;500;700&amp;display=swap"
    rel="stylesheet" />
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Outlined" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet" />
  <script>
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            primary: "#000000",
            "background-light": "#FFFFFF",
            "background-dark": "#0a0a0a",
            "surface-light": "#F3F4F6", // Gray-100
            "surface-dark": "#171717", // Neutral-900
            "card-light": "#f8f8f8",
            "card-dark": "#1e1e1e",
            accent: "#ef4444", // Red for discount/tags
          },
          fontFamily: {
            display: ["Oswald", "sans-serif"],
            body: ["Inter", "sans-serif"],
          },
          borderRadius: {
            DEFAULT: "0px", // Streetwear often prefers sharp edges for a brutalist feel
          },
        },
      },
    };
  </script>
  <style>
    ::-webkit-scrollbar {
      width: 8px;
    }

    ::-webkit-scrollbar-track {
      background: transparent;
    }

    ::-webkit-scrollbar-thumb {
      background: #d1d5db;
    }

    ::-webkit-scrollbar-thumb:hover {
      background: #9ca3af;
    }

    .dark ::-webkit-scrollbar-thumb {
      background: #4b5563;
    }

    input[type="number"]::-webkit-inner-spin-button,
    input[type="number"]::-webkit-outer-spin-button {
      -webkit-appearance: none;
      margin: 0;
    }
  </style>
</head>

<body
  class="bg-background-light dark:bg-background-dark text-black dark:text-white font-body transition-colors duration-300 antialiased pb-10 lg:pb-0">
  <!-- Header Component (loaded dynamically) -->
  <div id="header-placeholder"></div>

  <div class="container mx-auto px-4 pt-16 pb-6 text-center">
    <h1 id="page-title" class="font-display text-5xl md:text-7xl font-bold uppercase tracking-tighter mb-4">
      All Product
    </h1>
    <nav id="breadcrumb-nav" class="text-xs text-gray-500 dark:text-gray-400 mb-4 uppercase tracking-widest">
      <a class="hover:text-black dark:hover:text-white transition-colors" href="#">Home</a>
      <span class="mx-2">/</span>
      <span class="text-black dark:text-white font-medium">Men's Fashion</span>
    </nav>
    <!-- <p class="text-gray-500 dark:text-gray-400 text-sm max-w-md mx-auto leading-relaxed">
      result for "T-Shirts"
    </p> -->
  </div>
  <main class="container mx-auto px-4 pt-2 pb-12 flex flex-col lg:flex-row gap-12">
    <aside class="w-full lg:w-1/4 hidden lg:block">
      <div class="flex items-center justify-between h-16 mb-8 border-b border-gray-100 dark:border-gray-800">
        <h2 class="font-display text-2xl font-bold uppercase tracking-wide">
          Filters
        </h2>
        <button class="lg:hidden text-sm underline">Close</button>
      </div>
      <div class="space-y-10">
        <div>
          <h3 id="filter-header-category" onclick="toggleFilter('category')"
            class="font-display text-lg font-medium mb-4 flex items-center justify-between cursor-pointer select-none">
            CATEGORIES
            <span id="filter-icon-category" class="material-icons-outlined text-sm">expand_less</span>
          </h3>
          <div id="filter-content-category" class="space-y-3 transition-all duration-300">
            <div class="flex items-center justify-between group cursor-pointer">
              <span
                class="text-sm text-gray-600 dark:text-gray-400 group-hover:text-black dark:group-hover:text-white transition-colors">Men's
                Fashion</span>
              <span class="text-sm text-gray-500 dark:text-gray-500 font-mono">3</span>
            </div>
            <div class="flex items-center justify-between group cursor-pointer">
              <span
                class="text-sm text-gray-600 dark:text-gray-400 group-hover:text-black dark:group-hover:text-white transition-colors">Women's
                Fashion</span>
              <span class="text-sm text-gray-500 dark:text-gray-500 font-mono">3</span>
            </div>
            <div class="flex items-center justify-between group cursor-pointer">
              <span
                class="text-sm text-gray-600 dark:text-gray-400 group-hover:text-black dark:group-hover:text-white transition-colors">KIDS</span>
              <span class="text-sm text-gray-500 dark:text-gray-500 font-mono">1</span>
            </div>
            <div class="flex items-center justify-between group cursor-pointer">
              <span
                class="text-sm text-gray-600 dark:text-gray-400 group-hover:text-black dark:group-hover:text-white transition-colors">Men</span>
              <span class="text-sm text-gray-500 dark:text-gray-500 font-mono">0</span>
            </div>
          </div>
        </div>
        <div class="border-t border-gray-200 dark:border-gray-800 pt-6">
          <h3 id="filter-header-price" onclick="toggleFilter('price')"
            class="font-display text-lg font-medium mb-4 flex items-center justify-between cursor-pointer select-none">
            PRICE
            <span id="filter-icon-price" class="material-icons-outlined text-sm">expand_less</span>
          </h3>
          <div id="filter-content-price" class="transition-all duration-300">
            <div id="price-slider-container"
              class="relative h-1 bg-gray-200 dark:bg-gray-800 rounded-full mb-6 mt-2 select-none">
              <div id="price-slider-track" class="absolute left-0 right-0 h-1 bg-black dark:bg-white rounded-full"
                style="left: 0%; right: 0%"></div>
              <div id="price-slider-min"
                class="absolute left-0 top-1/2 transform -translate-y-1/2 -translate-x-1/2 w-4 h-4 bg-black dark:bg-white rounded-full cursor-pointer hover:scale-110 transition-transform z-10 shadow-md">
              </div>
              <div id="price-slider-max"
                class="absolute left-0 top-1/2 transform -translate-y-1/2 -translate-x-1/2 w-4 h-4 bg-black dark:bg-white rounded-full cursor-pointer hover:scale-110 transition-transform z-10 shadow-md"
                style="left: 100%"></div>
            </div>
            <div class="flex items-center space-x-4">
              <div class="flex-1">
                <div class="relative">
                  <span class="absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400 text-sm">₹</span>
                  <input id="price-input-min"
                    class="w-full pl-7 pr-3 py-2 text-sm bg-transparent border border-gray-300 dark:border-gray-700 focus:border-black dark:focus:border-white focus:ring-0 transition-colors font-mono"
                    type="number" value="0" min="0" max="2999" />
                </div>
              </div>
              <span class="text-sm text-gray-400">to</span>
              <div class="flex-1">
                <div class="relative">
                  <span class="absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400 text-sm">₹</span>
                  <input id="price-input-max"
                    class="w-full pl-7 pr-3 py-2 text-sm bg-transparent border border-gray-300 dark:border-gray-700 focus:border-black dark:focus:border-white focus:ring-0 transition-colors font-mono"
                    type="number" value="2999" min="0" max="2999" />
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="border-t border-gray-200 dark:border-gray-800 pt-6">
          <h3 id="filter-header-availability" onclick="toggleFilter('availability')"
            class="font-display text-lg font-medium mb-4 flex items-center justify-between cursor-pointer select-none">
            AVAILABILITY
            <span id="filter-icon-availability" class="material-icons-outlined text-sm">expand_less</span>
          </h3>
          <div id="filter-content-availability" class="space-y-3 transition-all duration-300">
            <label class="flex items-center group cursor-pointer">
              <input
                class="form-checkbox h-4 w-4 text-black border-gray-300 focus:ring-black dark:bg-gray-800 dark:border-gray-700 dark:checked:bg-white dark:checked:text-black dark:focus:ring-offset-gray-900 rounded-sm"
                type="checkbox" />
              <span
                class="ml-3 text-sm text-gray-600 dark:text-gray-400 group-hover:text-black dark:group-hover:text-white transition-colors">In
                stock (6)</span>
            </label>
            <label class="flex items-center group cursor-pointer">
              <input
                class="form-checkbox h-4 w-4 text-black border-gray-300 focus:ring-black dark:bg-gray-800 dark:border-gray-700 dark:checked:bg-white dark:checked:text-black dark:focus:ring-offset-gray-900 rounded-sm"
                type="checkbox" />
              <span
                class="ml-3 text-sm text-gray-600 dark:text-gray-400 group-hover:text-black dark:group-hover:text-white transition-colors">Out
                of stock (1)</span>
            </label>
          </div>
        </div>
      </div>
    </aside>
    <div class="flex-1">
      <div
        class="flex items-center justify-between mb-8 bg-background-light dark:bg-background-dark h-16 border-b border-gray-100 dark:border-gray-800">
        <div id="product-count" class="hidden lg:block text-sm text-gray-500 dark:text-gray-400 font-mono">
          Showing 8 products
        </div>
        <div class="flex items-center w-full lg:w-auto justify-between lg:justify-end">
          <div class="flex items-center space-x-4">
            <button onclick="toggleMobileFilter()"
              class="lg:hidden flex items-center space-x-2 text-sm font-medium uppercase tracking-wider">
              <span>Filter</span>
              <span class="material-icons-outlined text-base">expand_more</span>
            </button>
            <div class="relative">
              <button id="sort-button" onclick="toggleSortDropdown(event)"
                class="flex items-center space-x-2 text-sm font-medium hover:text-gray-600 dark:hover:text-gray-300 uppercase tracking-wider focus:outline-none">
                <span id="sort-text">Best selling</span>
                <span id="sort-icon"
                  class="material-icons-outlined text-base transition-transform duration-200">expand_more</span>
              </button>
              <div id="sort-dropdown"
                class="absolute right-0 top-full mt-2 w-56 bg-white dark:bg-card-dark rounded-lg shadow-xl py-2 z-50 transform origin-top-right transition-all duration-200 scale-95 opacity-0 invisible ring-1 ring-black ring-opacity-5">
                <a href="#" onclick="selectSortOption('Featured', event)"
                  class="block px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800">Featured</a>
                <a href="#" onclick="selectSortOption('Best selling', event)"
                  class="block px-4 py-2 text-sm font-bold text-gray-900 dark:text-white bg-gray-50 dark:bg-gray-800">Best
                  selling</a>
                <a href="#" onclick="selectSortOption('Alphabetically, A-Z', event)"
                  class="block px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800">Alphabetically,
                  A-Z</a>
                <a href="#" onclick="selectSortOption('Alphabetically, Z-A', event)"
                  class="block px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800">Alphabetically,
                  Z-A</a>
                <a href="#" onclick="selectSortOption('Price, low to high', event)"
                  class="block px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800">Price,
                  low to high</a>
                <a href="#" onclick="selectSortOption('Price, high to low', event)"
                  class="block px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800">Price,
                  high to low</a>
                <a href="#" onclick="selectSortOption('Date, old to new', event)"
                  class="block px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800">Date,
                  old to new</a>
                <a href="#" onclick="selectSortOption('Date, new to old', event)"
                  class="block px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800">Date,
                  new to old</a>
              </div>
            </div>
          </div>
          <!-- Desktop View Options (lg+) -->
          <div
            class="hidden lg:flex items-center space-x-2 border-l border-gray-200 dark:border-gray-700 pl-10 lg:ml-6">
            <button onclick="updateGridColumn('desktop', 3)" id="btn-desktop-3"
              class="p-2 rounded transition-colors text-gray-400 hover:text-black dark:hover:text-white">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="currentColor">
                <rect x="0" width="2" height="14" rx="1" />
                <rect x="6" width="2" height="14" rx="1" />
                <rect x="12" width="2" height="14" rx="1" />
              </svg>
            </button>
            <button onclick="updateGridColumn('desktop', 4)" id="btn-desktop-4"
              class="p-2 rounded transition-colors bg-black text-white dark:bg-white dark:text-black">
              <svg width="19" height="14" viewBox="0 0 19 14" fill="currentColor">
                <rect x="0" width="2" height="14" rx="1" />
                <rect x="5.66" width="2" height="14" rx="1" />
                <rect x="11.33" width="2" height="14" rx="1" />
                <rect x="17" width="2" height="14" rx="1" />
              </svg>
            </button>
            <button onclick="updateGridColumn('desktop', 5)" id="btn-desktop-5"
              class="p-2 rounded transition-colors text-gray-400 hover:text-black dark:hover:text-white">
              <svg width="24" height="14" viewBox="0 0 24 14" fill="currentColor">
                <rect x="0" width="2" height="14" rx="1" />
                <rect x="5.5" width="2" height="14" rx="1" />
                <rect x="11" width="2" height="14" rx="1" />
                <rect x="16.5" width="2" height="14" rx="1" />
                <rect x="22" width="2" height="14" rx="1" />
              </svg>
            </button>
          </div>

          <!-- Tablet View Options (sm-lg) -->
          <div
            class="hidden sm:flex lg:hidden items-center space-x-2 border-l border-gray-200 dark:border-gray-700 pl-6">
            <button onclick="updateGridColumn('tablet', 2)" id="btn-tablet-2"
              class="p-2 rounded transition-colors text-gray-400 hover:text-black dark:hover:text-white">
              <svg width="9" height="14" viewBox="0 0 9 14" fill="currentColor">
                <rect x="0" width="2" height="14" rx="1" />
                <rect x="7" width="2" height="14" rx="1" />
              </svg>
            </button>
            <button onclick="updateGridColumn('tablet', 3)" id="btn-tablet-3"
              class="p-2 rounded transition-colors bg-black text-white dark:bg-white dark:text-black">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="currentColor">
                <rect x="0" width="2" height="14" rx="1" />
                <rect x="6" width="2" height="14" rx="1" />
                <rect x="12" width="2" height="14" rx="1" />
              </svg>
            </button>
          </div>

          <!-- Mobile View Options (<sm) -->
          <div class="flex sm:hidden items-center space-x-2 border-l border-gray-200 dark:border-gray-700 pl-4 ml-4">
            <button onclick="updateGridColumn('mobile', 1)" id="btn-mobile-1"
              class="p-2 rounded transition-colors text-gray-400 hover:text-black dark:hover:text-white">
              <svg width="4" height="14" viewBox="0 0 4 14" fill="currentColor">
                <rect x="1" width="2" height="14" rx="1" />
              </svg>
            </button>
            <button onclick="updateGridColumn('mobile', 2)" id="btn-mobile-2"
              class="p-2 rounded transition-colors bg-black text-white dark:bg-white dark:text-black">
              <svg width="9" height="14" viewBox="0 0 9 14" fill="currentColor">
                <rect x="0" width="2" height="14" rx="1" />
                <rect x="7" width="2" height="14" rx="1" />
              </svg>
            </button>
          </div>
        </div>
      </div>
      <div id="product-grid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-x-6 gap-y-16">
        <div class="group">
          <div class="relative bg-card-light dark:bg-card-dark rounded-lg overflow-hidden mb-4">
            <span
              class="absolute top-2 left-2 bg-accent text-white text-[10px] font-bold px-2 py-0.5 uppercase tracking-wider rounded-sm z-10">Sale</span>
            <a href="product_detail.html" class="block">
              <img alt="Black graphic hoodie"
                class="w-full aspect-square object-cover group-hover:scale-105 transition-transform duration-500"
                src="https://lh3.googleusercontent.com/aida-public/AB6AXuDxmTnUKbWgghAdRg-J4ZbH64q33DU-PWdIHCpc0brPP2pzb1muszUobPyfeSVRKFa6JsRXrusj8BaIFodiQRdaqEjOzc-R1XcKBzcTiAfTEmsuP2eCyZGp-fZdyaiJ9X1mlKr35QJBLn0sg_-7Bxb_6oe5ka3TVOb1Yq8M6Xt2eNDUeu0qe8txz1-4VPZlmIT5PjyQckCvuv_hBXIqCRLWsS-lgG6eUwe5kpshgTsMyABXdcJAxutCqkkw0K2uyqZs93-SKgS1Ge1a" />
            </a>
            <button data-id="plist-ref-1" data-name="DEFENDER GAP" data-price="1499" data-original-price="4399"
              data-offer="65% OFF" data-tag="Sale"
              data-image="https://lh3.googleusercontent.com/aida-public/AB6AXuDxmTnUKbWgghAdRg-J4ZbH64q33DU-PWdIHCpc0brPP2pzb1muszUobPyfeSVRKFa6JsRXrusj8BaIFodiQRdaqEjOzc-R1XcKBzcTiAfTEmsuP2eCyZGp-fZdyaiJ9X1mlKr35QJBLn0sg_-7Bxb_6oe5ka3TVOb1Yq8M6Xt2eNDUeu0qe8txz1-4VPZlmIT5PjyQckCvuv_hBXIqCRLWsS-lgG6eUwe5kpshgTsMyABXdcJAxutCqkkw0K2uyqZs93-SKgS1Ge1a"
              class="wishlist-btn absolute top-2 right-2 z-10 bg-white text-black w-8 h-8 flex items-center justify-center rounded-full shadow-lg hover:scale-110 transition-all duration-300 opacity-100 xl:opacity-0 xl:group-hover:opacity-100">
              <span class="material-icons text-lg">favorite_border</span>
            </button>
          </div>
          <a href="product_detail.html" class="block group-hover:opacity-80 transition-opacity">
            <h3 class="font-bold text-sm text-gray-900 dark:text-white mb-1">
              DEFENDER GAP
            </h3>
            <div
              class="flex flex-col items-start space-y-1 sm:flex-row sm:items-center sm:space-y-0 sm:space-x-2 text-sm">
              <span class="font-bold text-gray-900 dark:text-white">Rs. 1,499</span>
              <span class="text-gray-400 line-through text-xs">Rs. 4,399</span>
              <span class="text-green-600 text-xs font-bold">65% OFF</span>
            </div>
          </a>
        </div>
        <div class="group">
          <div class="relative bg-card-light dark:bg-card-dark rounded-lg overflow-hidden mb-4">
            <a href="product_detail.html" class="block">
              <img alt="Back print graphic hoodie"
                class="w-full aspect-square object-cover group-hover:scale-105 transition-transform duration-500"
                src="https://lh3.googleusercontent.com/aida-public/AB6AXuBbLGazvs_rfyV7gSTN74B2QjZYOKQMCh-rxLzwtr5kOFKItsv1HmM3EAVR9IVlEWuTyhUQfShUrZZayYBsMFhWoaEJtFEMXXldH1dE0o9yId5vHpLfYm04VYHy4ey81p9WibZaXYF_fYD5UbeU_ifgC9FumKqd-qgNIUZE9jCws0_g-vuAXor0tc3D7VLioXJVAU_CwETh51mTcH4weIiUp26e89RgosY-2C_z0yqFutCM4dd4hR7JlEe6d78DMd4qv0u_eSAissJf" />
            </a>
            <button data-id="plist-ref-2" data-name="BULLET & DOLLAR" data-price="2999"
              data-image="https://lh3.googleusercontent.com/aida-public/AB6AXuBbLGazvs_rfyV7gSTN74B2QjZYOKQMCh-rxLzwtr5kOFKItsv1HmM3EAVR9IVlEWuTyhUQfShUrZZayYBsMFhWoaEJtFEMXXldH1dE0o9yId5vHpLfYm04VYHy4ey81p9WibZaXYF_fYD5UbeU_ifgC9FumKqd-qgNIUZE9jCws0_g-vuAXor0tc3D7VLioXJVAU_CwETh51mTcH4weIiUp26e89RgosY-2C_z0yqFutCM4dd4hR7JlEe6d78DMd4qv0u_eSAissJf"
              class="wishlist-btn absolute top-2 right-2 z-10 bg-white text-black w-8 h-8 flex items-center justify-center rounded-full shadow-lg hover:scale-110 transition-all duration-300 opacity-100 xl:opacity-0 xl:group-hover:opacity-100">
              <span class="material-icons text-lg">favorite_border</span>
            </button>
          </div>
          <a href="product_detail.html" class="block group-hover:opacity-80 transition-opacity">
            <h3 class="font-bold text-sm text-gray-900 dark:text-white mb-1">
              BULLET & DOLLAR
            </h3>
            <div
              class="flex flex-col items-start space-y-1 sm:flex-row sm:items-center sm:space-y-0 sm:space-x-2 text-sm">
              <span class="font-bold text-gray-900 dark:text-white">Rs. 2,999.00</span>
            </div>
          </a>
        </div>
        <div class="group">
          <div class="relative bg-card-light dark:bg-card-dark rounded-lg overflow-hidden mb-4">
            <span
              class="absolute top-2 left-2 bg-accent text-white text-[10px] font-bold px-2 py-0.5 uppercase tracking-wider rounded-sm z-10">Sale</span>
            <a href="product_detail.html" class="block">
              <img alt="Brown hoodie graphic"
                class="w-full aspect-square object-cover group-hover:scale-105 transition-transform duration-500"
                src="https://lh3.googleusercontent.com/aida-public/AB6AXuBXcyYSY0z7m1lJX8R7O7n_R4nH3nFCilbB-_fN9R33P9Bse5Ot6eUKSEm8LsRsdVMo3nu0GMJ7QYWN_FR0SnY6eqV9jSuxa6Si_ojv8W2XGgTW5e_9b9H3QIal8ccW3HA6-8COc1q4nhBtHBA2ZtKjgDXKo3BO9CIXH65Wxv_hpCntbkNUoppWCfRykfYDkCT3mUXd4WojKpNUqNlgIKIPbz0WKbtrGRCay5Ed97iBsAwmKkiJGUciDLVdbESgPvXuK8hXbyoP9Rj6" />
            </a>
            <button data-id="plist-ref-3" data-name="ARMED MAFIA" data-price="1499" data-original-price="2999"
              data-offer="50% OFF" data-tag="Sale"
              data-image="https://lh3.googleusercontent.com/aida-public/AB6AXuBXcyYSY0z7m1lJX8R7O7n_R4nH3nFCilbB-_fN9R33P9Bse5Ot6eUKSEm8LsRsdVMo3nu0GMJ7QYWN_FR0SnY6eqV9jSuxa6Si_ojv8W2XGgTW5e_9b9H3QIal8ccW3HA6-8COc1q4nhBtHBA2ZtKjgDXKo3BO9CIXH65Wxv_hpCntbkNUoppWCfRykfYDkCT3mUXd4WojKpNUqNlgIKIPbz0WKbtrGRCay5Ed97iBsAwmKkiJGUciDLVdbESgPvXuK8hXbyoP9Rj6"
