          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-sm text-gray-600 dark:text-gray-400">Men's Fashion</span>
              <span class="text-sm text-gray-500 font-mono">3</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-sm text-gray-600 dark:text-gray-400">Women's Fashion</span>
              <span class="text-sm text-gray-500 font-mono">3</span>
