            <div class="flex items-center justify-between">
              <span class="text-sm text-gray-600 dark:text-gray-400">KIDS</span>
              <span class="text-sm text-gray-500 font-mono">1</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-sm text-gray-600 dark:text-gray-400">Men</span>
              <span class="text-sm text-gray-500 font-mono">0</span>
            </div>
          </div>
        </div>

        <div class="border-t border-gray-200 dark:border-gray-800 pt-6"></div>

        <!-- Price -->
        <div>
          <h3 class="font-display text-lg font-medium mb-4">PRICE</h3>
          <div id="mobile-price-slider-container"
            class="relative h-1 bg-gray-200 dark:bg-gray-800 rounded-full mb-6 mt-2">
